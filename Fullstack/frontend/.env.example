# Base URL of the FastSearch REST API. Defaults to http://localhost:8080
# if unset (see src/lib/api.ts). Copy this file to .env.local and adjust
# if you're running the backend on a different host/port (e.g. inside
# Docker Compose, where it might be a service name instead of localhost).
VITE_API_BASE_URL=http://localhost:8080
